# Firebase Auth web config — public by design, safe in the browser.
# Firebase console → Project settings → General → Your apps → Add app (Web).
# Leave empty to fall back to the browser-local preview session.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# PortaD API origin (probed for the live status pill; defaults to the hosted API)
NEXT_PUBLIC_API_URL=https://portad-production.up.railway.app
